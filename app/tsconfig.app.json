{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* src/viz/AlphabetVisualizer.jsx is JS and stays JS — parsed, not diagnosed.
       This is the honest statement of that; a @ts-nocheck on a renamed .tsx would
       disable checking silently and forever. resolveJsonModule lets the alphabet
       test import public/alphabet.json directly, so the shipped default IS the
       fixture — one source of truth, no duplicated copy to drift. */
    "allowJs": true,
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}

# Generated by `wrangler types` from the pinned wrangler/workerd in node_modules —
# deterministic, contains no account state, and 14.7k lines that would otherwise
# churn a huge meaningless diff on every wrangler bump. The `prebuild` script
# regenerates it (~0.7s), so a fresh clone still builds with no extra step.
worker-configuration.d.ts
